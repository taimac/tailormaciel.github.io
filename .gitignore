# --- Python backend ---
__pycache__/
*.pyc
.venv/
env/
*.egg-info/
# Ignore local SQLite DBs (if used for dev)
*.sqlite3
*.db

# --- Node.js / Frontend ---
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Ignore frontend cache and lock files
package-lock.json
yarn.lock

# --- Frontend assets ---
frontend/js/dist/
frontend/js/build/
frontend/styles/dist/
frontend/styles/build/

# --- Environment / Secrets ---
.env
.env.*
# Never commit secrets or credentials

# --- Editor / IDE ---
.vscode/
.idea/
*.swp

# --- OS / Misc ---
.DS_Store
Thumbs.db

# --- Test / Coverage ---
coverage/
*.cover
*.log

# --- Scripts / Generated files ---
scripts/*.log
scripts/*.tmp

# --- Documentation build artifacts (if any) ---
docs/_build/
docs/.doctrees/
docs/.DS_Store

# --- Miscellaneous ---
*.bak
*.tmp